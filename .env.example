# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cms_saas?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Platform root domain (used for subdomain resolution)
# In production e.g. "platform.nl"; in local dev "localhost:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Storage driver: "local" or "s3"
STORAGE_DRIVER="local"
# When STORAGE_DRIVER=local, files are written here (outside /public) and
# served via the /uploads route handler.
LOCAL_UPLOAD_DIR="var/uploads"

# --- S3 (only needed when STORAGE_DRIVER=s3) ---
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# --- Stripe (stubbed for now) ---
STRIPE_ENABLED="false"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
