// CMS / Website-builder SaaS — multi-tenant schema
// Tenancy model: shared DB / shared schema, isolated per `siteId`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & access
// ---------------------------------------------------------------------------

enum GlobalRole {
  USER
  SUPER_ADMIN
}

enum SiteRole {
  OWNER
  EDITOR
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String?
  globalRole   GlobalRole   @default(USER)
  memberships  Membership[]
  accounts     Account[]
  sessions     Session[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Links a user to a site with a role inside that site.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  siteId    String
  role      SiteRole @default(EDITOR)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, siteId])
  @@index([siteId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Tenant (Site)
// ---------------------------------------------------------------------------

enum SiteStatus {
  ACTIVE
  SUSPENDED
}

model Site {
  id           String        @id @default(cuid())
  name         String
  subdomain    String        @unique
  customDomain String?       @unique
  status       SiteStatus    @default(ACTIVE)
  theme        Json          @default("{}")
  seo          Json          @default("{}")
  templateId   String?
  template     Template?     @relation(fields: [templateId], references: [id])
  pages        Page[]
  media        MediaAsset[]
  memberships  Membership[]
  subscription Subscription?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([templateId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

enum PageStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id          String     @id @default(cuid())
  siteId      String
  site        Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  content     Json       @default("[]") // array of block instances
  status      PageStatus @default(DRAFT)
  isHome      Boolean    @default(false)
  seo         Json       @default("{}")
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([siteId, slug])
  @@index([siteId])
}

// Catalogue of available block *types* (not instances).
// Instances live inside Page.content as JSON.
model Block {
  id          String   @id @default(cuid())
  type        String   @unique
  name        String
  category    String?
  icon        String?
  schema      Json     @default("{}")
  defaultData Json     @default("{}")
  createdAt   DateTime @default(now())
}

// Platform-wide starter templates.
model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  thumbnail   String?
  category    String?
  structure   Json     @default("{}") // pages + default block content
  isPublished Boolean  @default(true)
  sites       Site[]
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaAsset {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  url       String
  key       String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([siteId])
}

// ---------------------------------------------------------------------------
// Billing (stubbed Stripe for now)
// ---------------------------------------------------------------------------

enum Tier {
  FREE
  PRO
  BUSINESS
}

model Subscription {
  id                   String    @id @default(cuid())
  siteId               String    @unique
  site                 Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tier                 Tier      @default(FREE)
  status               String    @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// NextAuth adapter models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
